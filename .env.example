# KudyaParceiro is usually run in the Cursor browser (web) during local dev.
# Use localhost/127.0.0.1 — NOT 10.0.2.2 (that alias only works inside the Android emulator).
EXPO_PUBLIC_BASE_API=http://127.0.0.1:8000
EXPO_PUBLIC_API_PORT=8000

# Physical phone on same Wi‑Fi (replace with your PC IP — ipconfig / Expo "Network" line):
# EXPO_PUBLIC_BASE_API=http://192.168.x.x:8000

# Android emulator only:
# EXPO_PUBLIC_BASE_API=http://10.0.2.2:8000

# Production (set in EAS production profile):
# EXPO_PUBLIC_BASE_API=https://kudya-api.onrender.com

# Dev only — never set in production builds
# EXPO_PUBLIC_ALLOW_CLEARTEXT=true

EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_INSTAGRAM_APP_ID=
EXPO_PUBLIC_TIKTOK_CLIENT_KEY=

# Google Maps (Android native map tiles; same key as kudya-client if shared GCP project)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
